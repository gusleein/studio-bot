@props ScheduleProps

@template
{WeekTitle}

{#if IsEmpty}
😔 Занятий на эту неделю не запланировано.
{/if}
{#each Days as day}
<b>{day.Label}</b>
{#each day.Lessons as lesson}
  🕐 <b>{lesson.StartsAt}</b> – {lesson.EndsAt}{#if lesson.Room} | 🚪 {lesson.Room}{/if}
{#if lesson.Notes}
  📝 {lesson.Notes}
{/if}
{/each}

{/each}

@keyboard
[row]
[btn callback="{PrevCallback}"] ◀ Назад [/btn]
[btn callback="{NextCallback}"] Вперёд ▶ [/btn]
[/row]
[row]
[btn callback="{ToggleCallback}"] {ToggleLabel} [/btn]
[/row]
