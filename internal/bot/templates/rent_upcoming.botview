@props RentUpcomingProps

@template
📅 <b>Ближайшая аренда</b>

{#if HasRent}
📅 {Item.DateLabel}
🕐 {Item.TimeRange}
⏱ {Item.HoursLabel}
💰 {Item.Amount}
