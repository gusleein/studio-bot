APP_ENV=development

SERVER_HOST=0.0.0.0
SERVER_PORT=8088
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=60s

DB_HOST=localhost
DB_PORT=5432
DB_USER=studio
DB_PASSWORD=studio
DB_NAME=studio_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_DEBUG=false
TELEGRAM_BOT_TIMEOUT=60

JWT_SECRET=change_me_in_production
JWT_EXPIRATION=720h

TRIBUTE_API_KEY=your_tribute_api_key
TRIBUTE_BASE_URL=https://tribute.tg/api/v1
TRIBUTE_SHOP_ID=0
TRIBUTE_WEBHOOK_URL=https://your-domain.com/webhook/tribute

STORAGE_BASE_PATH=/data/packs
